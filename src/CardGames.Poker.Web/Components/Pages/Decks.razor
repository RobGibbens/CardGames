@page "/decks"
@rendermode InteractiveServer

<PageTitle>Custom Cards Gallery - Dealer's Choice Poker</PageTitle>

<CardGames.Poker.Web.Components.Shared.SiteNavBar/>

<main class="face-cards-page">
	<section class="face-cards-hero">
		<div class="face-cards-hero-copy">
			<p class="face-cards-kicker">Card Art Archive</p>
			<div class="face-cards-title-row">
				<h1 class="face-cards-title">Your custom deck</h1>
				<img class="face-cards-back"
				     src="@CardBackImagePath"
				     alt="Card back"
				     width="72"
				     height="103"/>
			</div>
		</div>
	</section>

	<section class="face-cards-gallery" aria-labelledby="face-cards-gallery-title">
		<div class="face-cards-gallery-header">
			<p class="face-cards-kicker">Gallery</p>
			<h2 id="face-cards-gallery-title" class="face-cards-gallery-title">All Cards</h2>
		</div>

		<div class="face-cards-suits">
			@foreach (var suit in Suits)
			{
				<section class="face-cards-suit" aria-labelledby="@GetSuitHeadingId(suit)">
					<header class="face-cards-suit-header">
						<div class="face-cards-suit-badge @GetSuitAccentClass(suit)">
							<span class="face-cards-suit-symbol" aria-hidden="true">@suit.Symbol</span>
							<h3 id="@GetSuitHeadingId(suit)" class="face-cards-suit-title">@suit.Label</h3>
						</div>
					</header>

					<div class="face-cards-grid">
						@foreach (var rank in Ranks)
						{
							var card = new CardPreview(suit, rank);
							<button type="button"
							        class="face-cards-card"
							        aria-label="@($"Enlarge {card.Alt}")"
							        @onclick="() => OpenCard(card)">
								<img class="face-cards-card-image"
								     src="@card.Src"
								     alt=""
								     loading="lazy"/>
							</button>
						}
					</div>
				</section>
			}
		</div>
	</section>
</main>

@if (_selectedCard is not null)
{
	<div class="face-cards-lightbox"
	     role="dialog"
	     aria-modal="true"
	     aria-label="@_selectedCard.Alt"
	     tabindex="-1"
	     @ref="_lightboxRef"
	     @onkeydown="HandleLightboxKeyDown"
	     @onclick="CloseCard">
		<button type="button"
		        class="league-modal-close-btn face-cards-lightbox-close"
		        aria-label="Close card preview"
		        @onclick="CloseCard"
		        @onclick:stopPropagation="true">
			<i class="fa-solid fa-xmark" aria-hidden="true"></i>
		</button>
		<div class="face-cards-lightbox-panel" @onclick:stopPropagation>
			<img class="face-cards-lightbox-image"
			     src="@_selectedCard.Src"
			     alt="@_selectedCard.Alt"/>
			<p class="face-cards-lightbox-caption">@_selectedCard.Alt</p>
		</div>
	</div>
}

@code {

	private const string CardBackImagePath = "/images/cards/back-blue-white.png";

	private CardPreview? _selectedCard;
	private ElementReference _lightboxRef;
	private bool _focusLightbox;

	private static readonly SuitDefinition[] Suits =
	[
		new("Spades", "spades", "♠"),
		new("Hearts", "hearts", "♥"),
		new("Diamonds", "diamonds", "♦"),
		new("Clubs", "clubs", "♣")
	];

	private static readonly RankDefinition[] Ranks =
	[
		new("ace", "Ace"),
		new("two", "Two"),
		new("three", "Three"),
		new("four", "Four"),
		new("five", "Five"),
		new("six", "Six"),
		new("seven", "Seven"),
		new("eight", "Eight"),
		new("nine", "Nine"),
		new("ten", "Ten"),
		new("jack", "Jack"),
		new("queen", "Queen"),
		new("king", "King")
	];

	private static string GetCardImagePath(SuitDefinition suit, RankDefinition rank)
	{
		return $"/images/cards/{suit.Slug}-{rank.Slug}.png";
	}

	private static string GetSuitHeadingId(SuitDefinition suit)
	{
		return $"face-cards-{suit.Slug}";
	}

	private static string GetSuitAccentClass(SuitDefinition suit)
	{
		return suit.Slug is "hearts" or "diamonds" ? "is-red" : "is-dark";
	}

	private void OpenCard(CardPreview card)
	{
		_selectedCard = card;
		_focusLightbox = true;
	}

	private void CloseCard()
	{
		_selectedCard = null;
	}

	private void HandleLightboxKeyDown(KeyboardEventArgs args)
	{
		if (args.Key == "Escape")
		{
			CloseCard();
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!_focusLightbox || _selectedCard is null)
		{
			return;
		}

		_focusLightbox = false;
		await _lightboxRef.FocusAsync();
	}

	private sealed record SuitDefinition(string Label, string Slug, string Symbol);

	private sealed record RankDefinition(string Slug, string Label);

	private sealed record CardPreview(string Src, string Alt)
	{
		public CardPreview(SuitDefinition suit, RankDefinition rank)
			: this(GetCardImagePath(suit, rank), $"{rank.Label} of {suit.Label}")
		{
		}
	}

}