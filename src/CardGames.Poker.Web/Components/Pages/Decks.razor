@page "/decks"
@rendermode InteractiveServer
@using CardGames.Poker.Api.Clients
@using CardGames.Poker.Api.Contracts
@using CardGames.Poker.Web.Components.Shared
@using CardGames.Poker.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IProfileApi ProfileApi
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Custom Cards Gallery - Dealer's Choice Poker</PageTitle>

<CardGames.Poker.Web.Components.Shared.SiteNavBar/>

<main class="face-cards-page">
	<section class="face-cards-hero">
		<div class="face-cards-hero-copy">
			<p class="face-cards-kicker">Card Art Archive</p>
			<div class="face-cards-title-row">
				<h1 class="face-cards-title">Your custom deck</h1>
				@if (!string.IsNullOrWhiteSpace(_backUrl))
				{
					<img class="face-cards-back" src="@_backUrl" alt="Card back" width="72" height="103"/>
				}
			</div>
		</div>
	</section>

	@if (_faces is not null)
	{
		<DeckGallery Title="All Cards"
		             BackUrl="@_backUrl"
		             FaceUrls="@_faces"
		             UseBuiltInFallback="true"/>
	}
</main>

@code {
	private string? _backUrl;
	private IReadOnlyDictionary<string, string>? _faces;

	protected override async Task OnInitializedAsync()
	{
		SelectedCardDeckImagesDto images = CardDeckImages.BuiltIn();
		var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		if (auth.User.Identity?.IsAuthenticated == true)
		{
			var response = await ProfileApi.GetSelectedCardDeckImagesAsync();
			if (response.IsSuccessStatusCode && response.Content is not null)
			{
				images = response.Content;
			}
		}

		_backUrl = CardDeckImages.Back(images, Navigation);
		_faces = images.Faces.ToDictionary(
			pair => pair.Key,
			pair => CardDeckImages.FaceOrBuiltIn(images.Faces, pair.Key.Split('-')[0], pair.Key.Split('-')[1], Navigation),
			StringComparer.Ordinal);
	}
}
