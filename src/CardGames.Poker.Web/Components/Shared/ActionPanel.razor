@namespace CardGames.Poker.Web.Components.Shared
@using CardGames.Contracts.SignalR
@using CardGames.Poker.Api.Contracts
@using static Pages.TablePlay

@inject IJSRuntime JSRuntime

<div @ref="_panelRef" class="play-panel action-panel @(IsSubmitting ? "submitting" : "")" data-testid="action-panel">
	<div @ref="_handleRef" class="drag-handle" title="Drag to move">
		<i class="fa-thin fa-grip-dots"></i>
	</div>
	@if (!string.IsNullOrWhiteSpace(HandDescription))
	{
		<div class="hand-eval-text">@HandDescription</div>
		<div class="action-panel-hand-separator" aria-hidden="true"></div>
	}

	<!-- Action buttons -->
	<div class="action-buttons">
		@if (LegalActions.Contains(BettingActionType.Fold))
		{
			<button type="button" class="action-btn fold-btn" data-testid="action-fold" @onclick="() => SubmitAction(BettingActionType.Fold)" disabled="@IsSubmitting">
				<i class="action-icon fa-thin fa-circle-down"></i>
				<span class="action-label">Fold</span>
			</button>
		}

		@if (LegalActions.Contains(BettingActionType.Check))
		{
			<button type="button" class="action-btn check-btn" data-testid="action-check" @onclick="() => SubmitAction(BettingActionType.Check)" disabled="@IsSubmitting">
				<i class="action-icon fa-thin fa-circle-check"></i>
				<span class="action-label">Check</span>
			</button>
		}

		@if (LegalActions.Contains(BettingActionType.Call))
		{
			<button type="button" class="action-btn call-btn" data-testid="action-call" @onclick="() => SubmitAction(BettingActionType.Call)" disabled="@IsSubmitting">
				<i class="action-icon fa-thin fa-circle-phone"></i>
				<span class="action-label">Call @FormatAmount(CurrentBetToCall)</span>
			</button>
		}

		@if (LegalActions.Contains(BettingActionType.Bet))
		{
			<button type="button" class="action-btn bet-btn" data-testid="action-bet" @onclick="() => SubmitAction(BettingActionType.Bet, betAmount)" disabled="@IsSubmitting">
				<i class="action-icon fa-thin fa-circle-dollar"></i>
				<span class="action-label">Bet @FormatAmount(betAmount)</span>
			</button>
		}

		@if (LegalActions.Contains(BettingActionType.Raise))
		{
			<button type="button" class="action-btn raise-btn" data-testid="action-raise" @onclick="() => SubmitAction(BettingActionType.Raise, betAmount)" disabled="@IsSubmitting">
				<i class="action-icon fa-thin fa-circle-plus"></i>
				<span class="action-label">Raise to @FormatAmount(betAmount)</span>
			</button>
		}

		@if (LegalActions.Contains(BettingActionType.AllIn))
		{
			<button type="button" class="action-btn allin-btn" data-testid="action-all-in" @onclick="() => SubmitAction(BettingActionType.AllIn)" disabled="@IsSubmitting">
				<i class="action-icon fa-thin fa-circle-a"></i>
				<span class="action-label">All In!</span>
			</button>
		}
	</div>

	<!-- Bet sizing controls (shown when bet/raise is available) -->
	@if (LegalActions.Contains(BettingActionType.Bet) || LegalActions.Contains(BettingActionType.Raise))
	{
		<div class="bet-controls">
			<div class="bet-slider-container">
				<input type="range"
				       class="bet-slider"
				       min="@GetEffectiveMinBet()"
				       max="@MaxBet"
				       step="@GetBetStep()"
				       @bind="betAmount"
				       @bind:event="oninput"
				       disabled="@IsSubmitting"/>
				<div class="bet-slider-labels">
					<span>@FormatAmount(GetEffectiveMinBet())</span>
					<span>@FormatAmount(MaxBet)</span>
				</div>
			</div>

			<div class="bet-input-group d-flex align-items-center gap-1">
				@if (DisplayChipsAsCurrency)
				{
					<span aria-hidden="true">$</span>
					<input type="number"
					       class="bet-input"
					       data-testid="bet-amount"
					       min="@ChipAmountFormat.ToDollars(GetEffectiveMinBet())"
					       max="@ChipAmountFormat.ToDollars(MaxBet)"
					       step="0.01"
					       value="@ChipAmountFormat.InputValue(betAmount, true)"
					       @onchange="OnBetAmountInput"
					       disabled="@IsSubmitting"/>
				}
				else
				{
					<input type="number"
					       class="bet-input"
					       data-testid="bet-amount"
					       min="@GetEffectiveMinBet()"
					       max="@MaxBet"
					       @bind="betAmount"
					       disabled="@IsSubmitting"/>
				}
			</div>

			<div class="bet-quick-buttons">
				<button type="button" class="quick-bet-btn" @onclick="() => SetBetAmount(GetEffectiveMinBet())" disabled="@IsSubmitting">Min</button>
				<button type="button" class="quick-bet-btn" @onclick="() => SetBetAmount(GetPotBet(0.5))" disabled="@IsSubmitting">½ Pot</button>
				<button type="button" class="quick-bet-btn" @onclick="() => SetBetAmount(GetPotBet(1.0))" disabled="@IsSubmitting">Pot</button>
				<button type="button" class="quick-bet-btn" @onclick="() => SetBetAmount(MaxBet)" disabled="@IsSubmitting">Max</button>
			</div>
		</div>
	}

	@if (IsSubmitting)
	{
		<div class="action-submitting">
			<span class="loading-spinner-small"></span>
			Submitting...
		</div>
	}

	@if (!IsSubmitting)
	{
		<div class="turn-timer action-panel-timer">
			<div class="timer-bar">
				<div class="timer-fill" style="width: @GetTimerPercentage()%"></div>
			</div>
			<span class="timer-text">@GetSecondsRemaining() s</span>
		</div>
	}
</div>

@code {
	private const int DefaultTimerDurationSeconds = 60;
	private const string PanelStorageKey = "cardGames.panelPosition.actionPanel";

	private ElementReference _panelRef;
	private ElementReference _handleRef;
	private bool _dragInitialized;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!_dragInitialized)
		{
			_dragInitialized = true;
			await JSRuntime.InvokeVoidAsync("draggablePanel.init", _panelRef, _handleRef, PanelStorageKey);
		}
	}

	[Parameter] public List<BettingActionType> LegalActions { get; set; } = [];

	[Parameter] public int MinBet { get; set; } = 10;

	[Parameter] public int MaxBet { get; set; } = 1000;

	[Parameter] public int CurrentBetToCall { get; set; }

	[Parameter] public int PlayerChips { get; set; }

	/// <summary>
	///     The minimum raise amount (pre-calculated by the server as CurrentBet + LastRaiseAmount).
	/// </summary>
	[Parameter]
	public int MinRaise { get; set; }

	[Parameter] public EventCallback<PlayerActionRequest> OnAction { get; set; }

	[Parameter] public bool IsSubmitting { get; set; }

	/// <summary>
	///     The action timer state from SignalR.
	/// </summary>
	[Parameter]
	public ActionTimerStateDto? ActionTimer { get; set; }

	[Parameter] public string? HandDescription { get; set; }

	/// <summary>
	///     The total pot from SignalR game state, used for pot-size betting buttons.
	/// </summary>
	[Parameter]
	public int TotalPot { get; set; }

	[CascadingParameter(Name = "DisplayChipsAsCurrency")]
	public bool DisplayChipsAsCurrency { get; set; }

	private int betAmount;

	private string FormatAmount(int chips) =>
		DisplayChipsAsCurrency ? ChipAmountFormat.Format(chips, true) : chips.ToString();

	private void OnBetAmountInput(ChangeEventArgs args)
	{
		if (!ChipAmountFormat.TryParseInput(args.Value?.ToString(), asCurrency: true, out var chips))
			return;

		SetBetAmount(chips);
	}

	protected override Task OnParametersSetAsync()
	{
		var effectiveMin = GetEffectiveMinBet();

		// Initialize bet amount to minimum if not set or below the effective minimum
		if (betAmount < effectiveMin)
		{
			betAmount = effectiveMin;
		}
		else if (betAmount > MaxBet)
		{
			betAmount = MaxBet;
		}

		return Task.CompletedTask;
	}

	private int GetSecondsRemaining()
	{
		return ActionTimer?.SecondsRemaining ?? DefaultTimerDurationSeconds;
	}

	private int GetTimerDuration()
	{
		return ActionTimer?.DurationSeconds ?? DefaultTimerDurationSeconds;
	}

	private double GetTimerPercentage()
	{
		var duration = GetTimerDuration();
		if (duration <= 0) return 100;
		return GetSecondsRemaining() / (double)duration * 100;
	}

	private async Task SubmitAction(BettingActionType action, int? amount = null)
	{
		if (IsSubmitting)
			return;

		await OnAction.InvokeAsync(new PlayerActionRequest(action, amount));
	}

	private void SetBetAmount(int amount)
	{
		betAmount = Math.Clamp(amount, GetEffectiveMinBet(), MaxBet);
	}

	/// <summary>
	///     Gets the effective minimum bet/raise amount.
	///     For raises, uses the server-provided MinRaise value.
	///     For bets, the minimum is MinBet.
	/// </summary>
	private int GetEffectiveMinBet()
	{
		if (LegalActions.Contains(BettingActionType.Raise))
		{
			// Use the server-provided minimum raise amount
			return Math.Max(MinRaise, MinBet);
		}

		return MinBet;
	}

	private int GetBetStep()
	{
		// Step size based on bet range
		var range = MaxBet - MinBet;
		if (range < 100) return 1;
		if (range < 500) return 5;
		if (range < 1000) return 10;
		if (range < 5000) return 25;
		return 50;
	}

	private int GetPotBet(double multiplier)
	{
		// Use actual pot total from game state when available, fall back to approximation
		var basePot = TotalPot > 0 ? TotalPot : CurrentBetToCall * 2;
		var potBet = (int)(basePot * multiplier);
		return Math.Clamp(potBet, GetEffectiveMinBet(), MaxBet);
	}

}
