# Copy to deploy/.env and fill in real values. Never commit .env.
#
# Hostnames only (no https://). Point Dynu A records at this PC.
# HTTPS is the shared Caddy in the DraftIQ repo: deploy/edge.
PUBLIC_WEB_HOST=dealerschoicepoker.net
PUBLIC_API_HOST=api.dealerschoicepoker.net

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Required by SQL Server Linux and the Service Bus emulator.
# https://go.microsoft.com/fwlink/?LinkId=746388
# https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
ACCEPT_EULA=Y

SQL_DATABASE=cardsdb

# App database SA password. 8+ characters with upper, lower, number, and symbol.
# Do not use ; # or ! unquoted. Quote the value if it contains # or !.
SQL_SA_PASSWORD=ChangeMe-CardGames1

# Separate SA password for the Service Bus emulator's SQL Server. Same rules.
EMULATOR_MSSQL_SA_PASSWORD=ChangeMe-Emulator1

# AMQP on the Compose network. AmqpWebSockets was for hosts that block 5672.
ServiceBus__TransportType=AmqpTcp

# Same value on Web and API. 32+ characters.
InternalIdentity__SigningKey=change-me-to-a-random-32-plus-character-secret

Email__Enabled=true
Resend__ApiKey=
Resend__From=CardGames <noreply@dealerschoicepoker.net>

# Redirect URIs (site host, not the API host):
#   https://dealerschoicepoker.net/signin-google
#   https://dealerschoicepoker.net/signin-microsoft
#   https://dealerschoicepoker.net/signin-oidc
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=
Authentication__Yahoo__ClientId=
Authentication__Yahoo__ClientSecret=

